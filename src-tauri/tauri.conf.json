{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ManagerDesk",
  "version": "../package.json",
  "identifier": "com.managerdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ManagerDesk",
        "width": 1024,
        "height": 768,
        "visible": false
      },
      {
        "title": "ManagerDesk Splash",
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

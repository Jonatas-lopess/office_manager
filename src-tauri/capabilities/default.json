{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "\\SERVER\\AppUpdate\\version.txt" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "\\SERVER\\AppUpdate\\office_manager_installer.msi" }]
    }
  ]
}
